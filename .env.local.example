# BudgetMirror AI — environment template
# Copy to .env.local and fill in. Never commit real keys.

# Supabase (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — SERVER ONLY (used in API routes via lib/gemini.ts)
GEMINI_API_KEY=your-gemini-api-key

# Public app URL (used for links / metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
